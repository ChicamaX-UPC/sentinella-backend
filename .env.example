# Variables de entorno alineadas a application.properties (Spring relaxed binding).
# Copia a .env y carga en el shell, o define en el IDE / k8s / compose.

SERVER_PORT=8080
LOG_LEVEL=INFO

DATABASE_URL=jdbc:postgresql://localhost:5432/sentinella
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# true = al arranque inserta usuarios/nodos/alertas demo (idempotente). Producción: false.
SENTINELLA_SEED_ENABLED=true

RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT vacío = par generado en memoria (solo dev). En prod: PEM en una línea.
# JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY=
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Cifrado AES-256-GCM en reposo (teléfono, tokens push). Generar: openssl rand -base64 32
# SENTINELLA_FIELD_ENCRYPTION_KEY=

# Orígenes web permitidos para CORS (solo origen, sin path).
# Ejemplo: http://localhost:3000,http://localhost:8080
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

TRACE_HEADER=X-Trace-Id
TRACING_SAMPLING_PROBABILITY=1.0
# OTLP HTTP: con `docker compose up` + servicio jaeger queda en localhost:4318; UI en http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
NODE_OFFLINE_METRIC_DELAY_MS=30000

# --- Google Maps (Monitoring Insights / dashboard geocode) ---
# Habilita "Geocoding API" en Google Cloud Console y restringe la key por IP/referrer.
# SENTINELLA_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=   # alias usado por docker-compose

# --- SendGrid (reportes + alertas EMAIL) ---
# Sin autenticar dominio en SendGrid: verifica un remitente en Settings → Sender Authentication → Single Sender.
# SENTINELLA_SENDGRID_API_KEY=
# SENDGRID_API_KEY=        # alias docker-compose
# SENTINELLA_SENDGRID_FROM_EMAIL=tu-email-verificado@ejemplo.com
# SENDGRID_FROM_EMAIL=

# --- Resend (correos de facturación / Stripe en payments-service) ---
# Prioridad sobre SendGrid en payments-service. En prueba: onboarding@resend.dev (solo a tu email registrado en Resend).
# SENTINELLA_RESEND_API_KEY=re_...
# SENTINELLA_RESEND_FROM_EMAIL=Sentinella <onboarding@resend.dev>

ALERTS_NOTIFICATIONS_ENABLED=false
ALERTS_EMAIL_ENABLED=false
ALERTS_EMAIL_API_URL=https://api.sendgrid.com/v3/mail/send
# ALERTS_EMAIL_API_KEY=    # misma key que SENDGRID_API_KEY
# ALERTS_EMAIL_FROM=       # debe coincidir con remitente verificado en SendGrid
# ALERTS_EMAIL_TO=         # destino de prueba para alertas por email
ALERTS_SMS_ENABLED=false
ALERTS_NOTIFICATIONS_ENABLED=true
ALERTS_PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=
# ALERTS_TWILIO_ACCOUNT_SID=
# ALERTS_TWILIO_AUTH_TOKEN=
# ALERTS_SMS_FROM=
# ALERTS_SMS_TO=

STORAGE_S3_ENABLED=true
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=sentinella
STORAGE_S3_PREFIX=reports
STORAGE_S3_ACCESS_KEY=minio
STORAGE_S3_SECRET_KEY=minio12345
STORAGE_S3_PRESIGN_SECONDS=3600
STORAGE_S3_ENDPOINT=http://127.0.0.1:9000

# SENTINELLA_PRESENCE_OFFLINE_AFTER_SECONDS=120
# SENTINELLA_PRESENCE_CHECK_MS=30000
# SENTINELLA_ALERT_ESCALATION_ENABLED=true
# SENTINELLA_ALERT_ESCALATION_CHECK_MS=60000

# --- Stripe (payments-service; generar con scripts/stripe-setup.ps1) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # stripe listen --print-secret
# STRIPE_SUCCESS_URL=https://TU-TUNEL-FRONT/dashboard?billing=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://TU-TUNEL-FRONT/subscribe?billing=cancel
# STRIPE_PORTAL_RETURN_URL=https://TU-TUNEL-FRONT/profile?billing=1
# STRIPE_DEMO_CONFIRM_ENABLED=false  # solo localhost; habilitar solo en dev local

# --- Blockchain / Fabric (stack unificado Docker Desktop) ---
# COMPOSE_PROFILES=fabric
# BLOCKCHAIN_FABRIC_ENABLED=true
# SENTINELLA_INTERNAL_SERVICE_KEY=   # obligatorio si SENTINELLA_INTERNAL_REQUIRE_KEY=true
# SENTINELLA_INTERNAL_REQUIRE_KEY=false
# SENTINELLA_AUTH_OPEN_REGISTRATION=false  # prod: solo invitación
# SENTINELLA_OPENAPI_PUBLIC=false          # prod: ocultar Swagger en gateway y microservicios
# STRIPE_PRICE_ECONOMY_RECURRING=price_...
# STRIPE_PRICE_ECONOMY_SETUP=price_...
# STRIPE_PRICE_PREMIUM_RECURRING=price_...
# STRIPE_PRICE_PREMIUM_SETUP=price_...
# STRIPE_PRICE_MAX_RECURRING=price_...
# STRIPE_PRICE_MAX_SETUP=price_...
