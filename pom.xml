<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>com.chicamax</groupId>
    <artifactId>sentinella-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>sentinella-platform</name>
    <description>Plataforma Sentinella: microservicios (evolución), contratos de eventos y arquitectura hexagonal por BC</description>

    <modules>
        <module>sentinella-contracts</module>
        <module>sentinella-common</module>
        <module>sentinella-api-gateway</module>
        <module>sentinella-iam-service</module>
        <module>sentinella-monitoring-service</module>
        <module>sentinella-alerts-service</module>
        <module>sentinella-plant-management-service</module>
        <module>sentinella-dashboard-service</module>
        <module>sentinella-reports-service</module>
        <module>sentinella-simulations-service</module>
        <module>sentinella-profiles-service</module>
        <module>sentinella-payments-service</module>
        <module>sentinella-subscriptions-service</module>
        <module>sentinella-blockchain-service</module>
    </modules>

    <profiles>
        <profile>
            <id>legacy</id>
            <modules>
                <module>sentinella-fieldops-service</module>
                <module>sentinella-nodeadmin-service</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.5</springdoc.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.chicamax</groupId>
                <artifactId>sentinella-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.chicamax</groupId>
                <artifactId>sentinella-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
